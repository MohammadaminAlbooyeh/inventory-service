{
  "title": "inventory-service",
  "uid": "inventory-service",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(up{job=\"inventory-service\"}, instance)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Reservation outcomes (rate/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(inventory_reservations_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Insufficient-stock ratio (5m)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.25 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(inventory_reservations_total{outcome=\"insufficient_stock\"}[5m])) / clamp_min(sum(rate(inventory_reservations_total[5m])), 0.001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Outbox pending",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "targets": [
        { "expr": "max(inventory_outbox_pending{instance=~\"$instance\"})" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reservation expiries (per 10m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(inventory_reservations_total{outcome=\"expired\"}[10m])) * 600",
          "legendFormat": "expired/10m"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dead-letter messages",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (topic) (increase(inventory_kafka_dlt_total[15m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{uri}}"
        }
      ]
    }
  ]
}
